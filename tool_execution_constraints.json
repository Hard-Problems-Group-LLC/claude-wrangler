{
  "schema_version": "1.0.0",
  "products": {
    "codex": {
      "sandbox_technologies": {
        "bubblewrap": {
          "environments": {
            "managed_linux_sandbox": {
              "match": {
                "env_all_of": {
                  "CODEX_CI": "1",
                  "CODEX_MANAGED_BY_NPM": "1",
                  "CODEX_SANDBOX_NETWORK_DISABLED": "1"
                },
                "signal_quality": "heuristic"
              },
              "tools": {
                "black": {
                                                "parallel_safety": {
                                                    "status": "unsafe",
                                                    "applies_when": {
                                                        "invocation_kind": "any",
                                                        "path_count_gte": 2
                                                    },
                                                    "preferred_workaround": {
                      "mode": "serial_explicit_paths"
                    },
                    "confidence": "high",
                    "evidence": [
                      "https://github.com/openai/codex/issues/15283"
                    ],
                    "notes": "Single-file Black succeeds in this environment, but multi-file Black can hang and `black -W 1` is not sufficient."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
